# VoiceL2D MVP - Environment Variables
# Only sensitive data (API keys) should be here
# Non-sensitive configuration is in config.toml

# ============================================
# API Keys (Required)
# ============================================

# ZhipuAI API key for LLM (GLM-4-Flash)
ZHIPU_API_KEY=

# SiliconCloud API key for ASR (SenseVoice)
# Only needed if ASR_MODE=api in config.toml
SILICONCLOUD_API_KEY=

# ============================================
# TTS Host (Required)
# ============================================

# GPT-SoVITS API host
GPT_SOVITS_HOST=http://localhost:9880

# ============================================
# ASR Mode Selection
# ============================================

# Override ASR mode: 'api' or 'local'
# If not set, defaults to 'api'
# ASR_MODE=api
