# ============================================
# LLM Configuration (ZhipuAI GLM)
# ============================================
ZHIPU_API_KEY= # Your ZhipuAI API key for LLM (GLM-4-Flash)

# ============================================
# ASR (Speech-to-Text) Configuration
# ============================================
# ASR Mode: 'api' for cloud API (default), 'local' for Faster-Whisper local
ASR_MODE=api

# --- API Mode (SiliconCloud) ---
# Uses SiliconCloud's ASR API (SenseVoice)
SILICONCLOUD_API_KEY= # Your SiliconCloud API key for ASR

# --- Local Mode (Faster-Whisper) ---
# Requires: uv sync --extra local-asr
WHISPER_MODEL=base  # Model size: tiny, base, small, medium, large-v3
WHISPER_LANGUAGE=zh  # Language code (e.g., 'zh', 'en') or leave empty for auto-detect

# ============================================
# TTS Configuration (GPT-SoVITS)
# ============================================
GPT_SOVITS_HOST= # Your GPT-SoVITS API host, e.g. http://localhost:9880
